# Backend API base URL (Next.js rewrites /api to this in dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key - NEVER put service role key here
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (set to true once configured in Supabase dashboard)
NEXT_PUBLIC_GOOGLE_ENABLED=true

# Government SSO domain (leave empty until SSO provider is configured)
NEXT_PUBLIC_SSO_DOMAIN=
