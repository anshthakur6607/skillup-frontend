# Backend URL (required)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Supabase (required — anon key only, never service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SSO domain (optional — for government SSO, disabled until configured in Supabase dashboard)
NEXT_PUBLIC_SSO_DOMAIN=

# NOTE: AI API keys (Gemini, Sarvam) are NOT used in the frontend.
# All AI calls go through the backend /api/ai/chat endpoint.
# This keeps API keys secure on the server side.
