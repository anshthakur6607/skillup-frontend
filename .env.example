[TEMPLATE]
# Backend API base URL — in dev, Next.js rewrites /api to this
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Supabase project URL (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key
# ⚠️  NEVER put the service role key here — NEXT_PUBLIC_ vars are in client JS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Provider API Keys (for course chatbot)
# Get Gemini key: https://aistudio.google.com/apikey (free tier available)
NEXT_PUBLIC_GEMINI_API_KEY=
# Get Sarvam key: https://api.sarvam.ai (free tier available)
NEXT_PUBLIC_SARVAM_API_KEY=
